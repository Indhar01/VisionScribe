rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /inspections/{inspectionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /auditTrail/{auditId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId && request.resource.data.userId == userId;
        allow delete: if false; // Audit trail is immutable - never allow deletion
      }
    }

    // Global audit trail (for analytics/compliance)
    match /auditLog/{auditId} {
      allow read: if false; // Only backend service account can read
      allow write: if false; // Only backend service account can write
    }
  }
}

